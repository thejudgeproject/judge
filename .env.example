# Configuration for the verifier in this repository.
#
#   cp .env.example .env
#
# Every value below is a placeholder. Nothing here is a credential and nothing here ever will
# be: verification is a read, and the only network call it makes is a public RPC query. Command
# line flags take precedence over these; see `judge-verify --help`.
#
# .env is git-ignored and must stay that way.

# Solana RPC endpoint used to read an anchoring transaction.   Flag: --rpc
#
# Configurable rather than fixed, deliberately. A verifier that can only ask one server is a
# verifier that trusts one server, and the point of checking an anchor yourself is not having
# to. Use your own node if you run one.
JUDGE_RPC_URL=https://api.mainnet-beta.solana.com

# The Solana account an anchoring transaction must be signed by, base58.   Flag: --publisher
#
# A memo in JUDGE's format proves nothing on its own, because anyone can write that text. The
# signature is what binds it. Left blank, the verifier falls back to the key named in the
# receipt, convenient, but it means trusting the receipt about who signed it.
JUDGE_PUBLISHER_KEY=

# How settled the transaction must be: confirmed, finalized or processed.   Flag: --commitment
JUDGE_COMMITMENT=confirmed

# The JUDGE application's own configuration (database bindings, signing material, access
# control, abuse-detection parameters) is not in this repository and is not documented here.
# See docs/ARCHITECTURE.md, "What is deliberately absent".
