# Dependencies and build output
node_modules/
# Generated in CI so `npm audit` has something to read; never committed, because this
# package has no dependencies and a lockfile for nothing is a lockfile that rots.
package-lock.json
dist/
build/
coverage/
*.tsbuildinfo

# Environment and configuration. .env.example is the only one that is ever committed.
.env
.env.*
!.env.example
*.local

# Credentials and keys, in every shape they show up in
*.pem
*.key
*.p8
*.p12
*.pfx
*.jks
*keypair*.json
*wallet*.json
*secret*.json
id_rsa*
id_ed25519*
.npmrc
.netrc

# Operational files that belong to a machine, not to a repository
.wrangler/
.dev.vars
wrangler.toml
.gate-code
.git-remote
.auth-keys
*.sqlite
*.sqlite3
*.db

# Logs and transient output
*.log
npm-debug.log*
yarn-error.log*
pnpm-debug.log*
*.tmp
*.bak
*.orig
*.rej

# Editor and operating system noise, which carries usernames and device names
.vscode/
.idea/
*.swp
*.swo
.DS_Store
._*
.Spotlight-V100
.Trashes
Thumbs.db
desktop.ini
$RECYCLE.BIN/
